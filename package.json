{
  "name": "planet-web2",
  "version": "0.2.0",
  "private": true,
  "cacheDirectories": [
    ".next/cache"
  ],
  "scripts": {
    "copy-maplibre-worker": "node scripts/copy-maplibre-worker.js",
    "postinstall": "npm run copy-maplibre-worker",
    "predev-https": "npm run copy-maplibre-worker",
    "dev-https": "next dev --experimental-https",
    "predev": "npm run copy-maplibre-worker",
    "dev": "next dev",
    "prebuild": "npm run copy-maplibre-worker",
    "build": "next build",
    "analyze": "ANALYZE=true npm run build",
    "start": "next start -p $PORT",
    "heroku-prebuild": "npm install --legacy-peer-deps --force",
    "heroku-postbuild": "npm run build",
    "lint": "eslint pages src",
    "lint:errors": "eslint pages src --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --exit-zero-on-changes",
    "prepare": "node ./husky-prepare.js",
    "analyze-css": "node scripts/css-static-analyzer.js",
    "analyze-css:ci": "node scripts/css-static-analyzer.js && echo 'CSS analysis passed'",
    "find-typos": "cspell --words-only --unique . | sort --ignore-case >> project-words.txt"
  },
  "validate-branch-name": {
    "pattern": "^(main|develop){1}$|^(feature|hotfix|fix)/[a-z0-9-_]+$",
    "errorMsg": "Invalid branch name. \n 1.Branch names can contain lowercase characters, numbers, hyphen and underscore. \n 2.Except for 'main' and 'develop', branch names must begin with 'feature/', 'fix', or 'hotfix/' "
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@auth0/auth0-react": "^1.6.0",
    "@date-io/date-fns": "1.3.13",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@formatjs/intl-localematcher": "^0.8.5",
    "@mapbox/togeojson": "^0.16.1",
    "@maplibre/maplibre-gl-compare": "^0.5.0",
    "@mui/icons-material": "^5.16.13",
    "@mui/lab": "^5.0.0-alpha.77",
    "@mui/material": "^5.12.2",
    "@mui/x-date-pickers": "^5.0.15",
    "@next/bundle-analyzer": "^15.5.25",
    "@planet-sdk/common": "^0.3.0",
    "@sentry/nextjs": "^10.73.0",
    "@turf/turf": "^5.1.6",
    "@types/geojson": "^7946.0.16",
    "@types/papaparse": "^5.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/react-gtm-module": "^2.0.1",
    "@types/react-lazyload": "^2.6.0",
    "@types/supercluster": "^7.1.0",
    "@vannizhang/wayback-core": "^1.0.8",
    "@vercel/kv": "^1.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.27.0",
    "deepmerge": "^4.3.1",
    "express": "^4.22.2",
    "framer-motion": "^2.9.5",
    "geocoder-arcgis": "^2.0.5",
    "geojson-validation": "^1.0.2",
    "jwt-decode": "^3.1.2",
    "maplibre-gl": "^6.8.0",
    "material-ui-popup-state": "^4.1.0",
    "negotiator": "^0.6.3",
    "next": "^15.5.25",
    "next-intl": "^4.13.0",
    "papaparse": "^5.5.2",
    "path-browserify": "^1.0.1",
    "prop-types": "^15.7.2",
    "qrcode": "^1.5.1",
    "react": "^18.3.1",
    "react-content-loader": "^5.1.4",
    "react-dom": "^18.3.1",
    "react-dropzone": "^11.4.0",
    "react-gtm-module": "^2.0.11",
    "react-hook-form": "^7.71.1",
    "react-insta-stories": "^2.8.0",
    "react-lazyload": "^3.2.0",
    "react-loading-skeleton": "^3.3.1",
    "react-map-gl": "^8.1.3",
    "react-player": "^2.8.2",
    "react-slick": "^0.30.2",
    "react-virtuoso": "^4.18.7",
    "sass": "^1.94.2",
    "slick-carousel": "^1.8.1",
    "styled-jsx": "^5.0.0",

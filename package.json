    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@emotion/eslint-plugin": "^11.12.0",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/nextjs": "10.6.0",
    "@types/geojson-validation": "^1.0.0",
    "@types/negotiator": "^0.6.3",
    "@types/node": "^22.17.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-slick": "^0.23.13",
    "@typescript-eslint/parser": "^8.70.0",
    "ajv": "^8.16.0",
    "chromatic": "^18.9.4",
    "cypress": "^15.19.0",
    "cypress-plugin-stripe-elements": "^1.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-cypress": "^6.4.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "^16.5.0",
    "husky": "^8.0.3",
    "jsdom": "^29.1.1",
    "knip": "^6.38.0",
    "prettier": "^2.0.5",
    "storybook": "10.6.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "validate-branch-name": "^1.3.0",
    "vitest": "^4.1.11",
    "webpack": "5.101.0"
  },
  "overrides": {
    "axios@>=1.0.0 <1.14.2": "1.14.0"
  }
}
